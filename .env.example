# ─── GHL (GoHighLevel) ───────────────────────────────────────────────────────
GHL_API_KEY=             # Private Integration Token (pit-xxxxxxxx)
GHL_AGENCY_API_KEY=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_WEBHOOK_SECRET=        # shared secret for validating inbound GHL webhooks

# ─── N8N ─────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.lbkh.solutions
N8N_API_KEY=
N8N_BOLDSTORE_TAG_ID=akucO9y04icJCSvB   # BOLDStore tag — apply to all BOLDStore workflows

# ─── Google ──────────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json   # path to SA JSON key
GOOGLE_DRIVE_ROOT_FOLDER_ID=                       # top-level BOLDStore Drive folder
GOOGLE_SHEETS_MASTER_ID=                           # master tracking sheet ID

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
APP_PORT=8000
WEBHOOK_BASE_URL=https://YOUR_PUBLIC_DOMAIN      # public URL this server is reachable at
LOG_LEVEL=INFO
