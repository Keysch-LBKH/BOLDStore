# ─── GHL (GoHighLevel) ───────────────────────────────────────────────────────
GHL_API_KEY=             # Sub-account Private Integration Token (pit-xxxxxxxx)
GHL_AGENCY_API_KEY=      # Agency-level key (leave blank for sub-account only)
GHL_LOCATION_ID=         # Found in GHL URL: /location/{ID}/dashboard
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_WEBHOOK_SECRET=        # shared secret for validating inbound GHL webhooks

# ─── N8N ─────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.lbkh.solutions
N8N_API_KEY=
N8N_BOLDSTORE_TAG_ID=akucO9y04icJCSvB   # BOLDStore tag — apply to all BOLDStore workflows

# ─── Google ──────────────────────────────────────────────────────────────────
# ─── Ghost Print Co. product pipeline ───────────────────────────────────────
GHOST_PRINT_BRAND_SHEET_ID=               # Brand Profile sheet (voice, prompts, store config)
GHOST_PRINT_ITEMS_SHEET_ID=               # Item Input sheet (products queued for N8N processing)

# ─── Google ──────────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json   # path to SA JSON key
GOOGLE_DRIVE_ROOT_FOLDER_ID=                       # top-level BOLDStore Drive folder (leave blank to use SA root)
GOOGLE_DRIVE_OWNER_EMAIL=                          # your Google account — bootstrap shares all folders with this
GOOGLE_SHEETS_MASTER_ID=                           # master tracking sheet ID (create manually, share with SA)

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
APP_PORT=8000
WEBHOOK_BASE_URL=https://YOUR_PUBLIC_DOMAIN      # public URL this server is reachable at
LOG_LEVEL=INFO
